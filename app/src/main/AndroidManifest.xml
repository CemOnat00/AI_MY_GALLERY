<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Bilerek INTERNET izni yok: uygulama tamamen cihaz üstüdür.
         Tek izin galeri okuma: Android 13+ READ_MEDIA_IMAGES, eski sürümlerde READ_EXTERNAL_STORAGE. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- onnxruntime-android AAR manifesti INTERNET ve ACCESS_NETWORK_STATE izinlerini ve Microsoft telemetri
         istemcisini başlatan TelemetryInitializer provider'ını ekler. Uygulama ağ ve telemetri kullanmaz;
         hepsi birleşik manifestten kaldırılır (aşağıda provider, application içinde). Ek savunma: kodda
         OrtEnvironment.setTelemetry(false). -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <!-- WorkManager (T-006) AAR manifesti ek olarak WAKE_LOCK ve RECEIVE_BOOT_COMPLETED (yeniden başlatma sonrası
         işi yeniden planlama) ile FOREGROUND_SERVICE izni ve SystemForegroundService'i ekler. İlk ikisi kalır
         (normal izinler, indeksleme işinin sürekliliği için). Foreground servis/bildirim bu görevin kapsamı dışı:
         izin ve servis çıkarılır; setForeground çağrılırsa çalışmaz, eklenmesi ayrı karardır. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AiGaleri">
        <!-- ORT telemetrisi (HttpClient, PowerInfoReceiver, ConnectivityCallback, cihaz/sistem bilgisi):
             provider olmadan yerel katman "Java HttpClient başlatılmadı" diyerek telemetriyi devre dışı bırakır. -->
        <provider
            android:name="ai.onnxruntime.TelemetryInitializer"
            android:authorities="${applicationId}.onnxruntime_telemetry_initializer"
            tools:node="remove" />
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            tools:node="remove" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
